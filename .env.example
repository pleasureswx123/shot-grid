# ShotGrid Light LAN server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# PostgreSQL connection
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://shotgrid:change-me@127.0.0.1:5432/shotgrid
DATABASE_SSL=false
DATABASE_POOL_MAX=20
AUTO_MIGRATE=true

# First startup only. Change the password before starting the server.
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_EMAIL=admin@studio.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-start

# Session settings
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false

# Central media storage. Put this on a server disk or a NAS mounted by the server.
STORAGE_ROOT=D:\ShotGridData
MAX_UPLOAD_MB=2048

# Optional future AI integration. Keep provider keys on the server only.
GEMINI_API_KEY=

# Security hardening
# Required in production unless ALLOW_INSECURE_PRODUCTION_COOKIES=true is set for a deliberate exception.
SESSION_COOKIE_SECURE=true
# Express trust proxy value for reverse-proxy deployments. Defaults to private/loopback proxies.
TRUST_PROXY=loopback, linklocal, uniquelocal
# Optional antivirus command; the uploaded temp file path is appended as the final argument.
# Example: VIRUS_SCAN_COMMAND=clamscan --no-summary
VIRUS_SCAN_COMMAND=
# Semicolon-separated NAS roots that the server may stream from for registered NAS review files.
# Leave empty to keep NAS entries as path-only references.
NAS_ROOT_WHITELIST=
